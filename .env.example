# Postgres
POSTGRES_USER=chatapp
POSTGRES_PASSWORD=changeme_dev_password
POSTGRES_DB=chatapp
DATABASE_URL=postgresql://chatapp:changeme_dev_password@postgres:5432/chatapp

# JWT
JWT_ACCESS_SECRET=changeme_generate_a_long_random_secret
JWT_REFRESH_SECRET=changeme_generate_a_different_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Encryption key for storing user-supplied Claude/OpenAI API keys (32 bytes, base64)
API_KEY_ENCRYPTION_KEY=changeme_32_byte_base64_key

# AI backends
OLLAMA_BASE_URL=http://host.docker.internal:11434

# claude/openai no longer take a per-user API key — both are gated by a small
# "host-bridge" service (see host-bridge/) that runs directly on the deployment host
# (not in Docker) and spawns the host's already-logged-in claude/codex CLIs. Leave all
# three unset to run with Ollama only. See docs/deployment.md for the full runbook,
# including why this only makes sense for a personal/single-operator deployment.
# CLAUDE_BRIDGE_URL=http://host.docker.internal:4171
# CODEX_BRIDGE_URL=http://host.docker.internal:4171
# HOST_BRIDGE_TOKEN=changeme_generate_a_long_random_secret

# Optional: local-GPU workspace coding. Points at the same host-bridge process as the two
# URLs above, but enables a different capability — the locally-hosted Ollama model gets
# real tools (list/read/write/search, and optionally run_command) against a directory on
# the host machine, instead of only ever emitting code into the chat transcript.
#
# Deliberately a separate opt-in from CLAUDE_BRIDGE_URL/CODEX_BRIDGE_URL: running the
# claude/codex CLI bridge must never imply granting a model write access to your disk.
# Unset (the default) means the backend sends no `tools` field to Ollama at all.
#
# The sandbox itself is configured on the host side, in host-bridge/.env — set
# BRIDGE_WORKSPACE_ROOT there to the one directory the model is allowed to touch. Without
# it, every workspace tool call comes back as an error and nothing on disk is reachable.
# WORKSPACE_BRIDGE_URL=http://host.docker.internal:4171

# Optional: chat memory. When set, the backend asks this Ollama model to extract durable
# facts/preferences after each finished exchange and injects them into future chats for
# that user (see backend/src/memory/). Always Ollama, regardless of which provider the
# user is chatting with — a cheap background task, not user-facing generation. Leave
# unset to disable the feature entirely (no extraction, no notes, no behavior change).
# MEMORY_EXTRACTION_MODEL=llama3.2:3b

# CORS allowlist (dev only; prod serves frontend+backend same-origin via nginx, so leave
# this empty/unset in prod — CORS gets disabled outright rather than defaulting to allow
# all origins). Comma-separated list of exact origins, e.g.:
#   CORS_ORIGIN=http://localhost:4200,https://staging.example.com
CORS_ORIGIN=http://localhost:4200

NODE_ENV=development

# Backoffice: comma-separated list of emails that always get full-permission admin
# access, re-applied on every backend startup and right after that email registers
# (see backend/src/admin/admin-bootstrap.service.ts). Meant for dev/staging so a known
# test account can drive the backoffice — clear this (or leave unset) in production once
# real admins are set up through the backoffice itself, since any email listed here
# regains super-admin on every restart regardless of what the UI changed it to.
BOOTSTRAP_ADMIN_EMAILS=ake.kidsapon@gmail.com

# Number of trusted reverse-proxy hops in front of the backend (nginx = 1); leave 0 for
# direct/local runs without a proxy in front, since trusting proxy headers you don't
# control lets clients spoof their IP. The dev override forces this to 0 regardless.
TRUST_PROXY=1

# Pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Optional: error reporting (Sentry). Leave unset to disable entirely — nothing is sent
# anywhere unless a DSN is configured. See docs/deployment.md for setup.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production

# Optional: only needed with docker-compose.cloudflare.yml, which exposes the stack on a
# public domain via a Cloudflare Tunnel (no open router ports / public IP required — fits
# a home server). Token comes from the Cloudflare Zero Trust dashboard: Networks >
# Tunnels > (your tunnel) > Configure. See docker-compose.cloudflare.yml for full setup.
# CLOUDFLARE_TUNNEL_TOKEN=

# Secrets (DATABASE_URL, JWT_ACCESS_SECRET, JWT_REFRESH_SECRET,
# API_KEY_ENCRYPTION_KEY) can each be supplied as a file instead of a plain value by
# setting the corresponding "<KEY>_FILE" variable to a file path (its content is read
# and trimmed at startup; a _FILE value always wins over a plain value of the same key).
# This is how docker-compose.secrets.yml wires in Docker Compose secrets, and the same
# convention works with a Vault agent template, a Kubernetes Secret mounted as a file, or
# any other secret manager that can render a value to disk — e.g.:
#   JWT_ACCESS_SECRET_FILE=/run/secrets/jwt_access_secret
