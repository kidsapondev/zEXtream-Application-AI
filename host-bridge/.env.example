# host-bridge runs directly on the deployment host (not in Docker) — see
# docs/deployment.md for the full runbook. Copy this to .env in this directory (or set
# these however you normally run a background process on the host) and fill in real
# paths/secret.

PORT=4171

# Must match HOST_BRIDGE_TOKEN in the backend's .env exactly — generate with e.g.
# `openssl rand -base64 32`. Anything that can reach this port and knows this token can
# spawn claude/codex under your login, so treat it like any other secret.
HOST_BRIDGE_TOKEN=changeme_generate_a_long_random_secret

# Absolute paths to the claude/codex CLI executables on this machine. Find yours with:
#   Windows: Get-ChildItem -Path $env:APPDATA,$env:LOCALAPPDATA -Filter claude.exe -Recurse
#            Get-ChildItem -Path $env:LOCALAPPDATA -Filter codex.exe -Recurse
CLAUDE_EXE_PATH=C:\path\to\claude.exe
CODEX_EXE_PATH=C:\path\to\codex.exe

# Optional: working directory for every spawned claude/codex invocation. Must stay
# outside any git repo and free of any CLAUDE.md/AGENTS.md — defaults to the OS temp
# directory, which already satisfies that.
# BRIDGE_NEUTRAL_CWD=C:\path\to\an\empty\scratch\directory

# Optional: wall-clock cap per chat invocation, in milliseconds.
# BRIDGE_CHAT_TIMEOUT_MS=120000

# Optional: enables the /workspace/* filesystem + exec API, sandboxed to this directory.
# Unset by default — every /workspace/* route (except /workspace/status) answers 503
# until this is set. Pick a dedicated folder, not a real project checkout: anything a
# locally-hosted LLM can be steered into reading/writing/running lives inside this tree.
# BRIDGE_WORKSPACE_ROOT=C:\path\to\an\llm-accessible\workspace

# Optional: caps both /workspace/read responses and /workspace/write payloads, in bytes.
# BRIDGE_MAX_FILE_BYTES=256000

# Optional: comma-separated bare command names /workspace/exec is allowed to run (e.g.
# "git,npm,pnpm"). Empty/unset by default — exec is off until the operator opts specific
# commands in. Never list a shell (cmd, powershell, bash, sh) here: this API spawns
# commands directly (no shell), so allowlisting a shell would defeat the allowlist by
# letting any command through as an argument to it.
# BRIDGE_EXEC_ALLOWLIST=git,npm,pnpm

# Optional: wall-clock cap per /workspace/exec invocation, in milliseconds.
# BRIDGE_EXEC_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# MCP server (host-bridge/src/mcp-main.ts, `pnpm --filter host-bridge start:mcp`)
# ---------------------------------------------------------------------------
# The MCP server exposes the local Ollama model to any MCP-capable IDE over stdio. It is
# a SEPARATE process from the Express server above and needs none of HOST_BRIDGE_TOKEN,
# CLAUDE_EXE_PATH or CODEX_EXE_PATH — an IDE launching it only needs the workspace and
# Ollama settings. It reads this same file (resolved relative to the package, not the
# IDE's working directory), and any variable the IDE sets in its own MCP config wins.
#
# BRIDGE_WORKSPACE_ROOT above is what gates it: unset, every MCP tool except
# local_model_status returns a "not configured" error. BRIDGE_MAX_FILE_BYTES,
# BRIDGE_EXEC_ALLOWLIST and BRIDGE_EXEC_TIMEOUT_MS apply to it identically.

# Optional: where the local Ollama daemon listens, as seen from the host. Defaults to
# http://localhost:11434. Note this is the host's own view — the backend container uses
# host.docker.internal instead, in its own .env.
# OLLAMA_BASE_URL=http://localhost:11434

# Optional: default model for the MCP `local_code_agent` tool. When unset, the server
# picks the first installed model that reports the `tools` capability, so a machine with
# one tool-capable model needs no setting at all. Set it when several are installed and
# the choice matters. The model MUST support tool calling; check with:
#   curl -s localhost:11434/api/tags | grep -o '"capabilities":\[[^]]*\]'
# (or just call the local_model_status tool, which reports this per model).
# MCP_AGENT_MODEL=qwen2.5-coder:14b
